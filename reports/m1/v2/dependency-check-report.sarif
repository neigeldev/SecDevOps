                    "cvssv3_availabilityImpact": "HIGH",
                    "cvssv3_baseSeverity": "CRITICAL",
"cvssv3_exploitabilityScore": "3.9","cvssv3_impactScore": "5.9","cvssv3_version": "_3_1",                "source": "NVD"
              }
            }          ],
