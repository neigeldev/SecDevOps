# Copia este archivo a terraform.tfvars (ignorado por Git) y ajústalo.
project     = "securenotes"
environment = "demo"
owner       = "tu-nombre"
region      = "us-east-1"

# Recibe las alarmas de seguridad por correo (hay que confirmar la suscripción)
alert_email = ""

# Etiqueta de la imagen que publicará scripts/m3-push-image.sh
image_tag = "2.0.0"

# WAF: ~USD 0.20/día. Ponlo en false si tu plan de AWS no lo permite.
enable_waf = true

# Backups de RDS: el Free plan de AWS solo permite 1 día (FreeTierRestrictionError).
# Con Paid plan usa 7 o más.
db_backup_retention_days = 7

# Versión de los secretos generados (BD, JWT, admin). Incrementa para rotarlos.
# IMPORTANTE: si un "apply" falla a medias (p. ej. después de crear los parámetros
# SSM pero antes de crear RDS), la contraseña de SSM y la de RDS quedan distintas
# (Terraform no guarda los valores efímeros). Súbelo a 2 y vuelve a aplicar para
# reescribir ambas con el mismo valor.
secrets_version = 1
