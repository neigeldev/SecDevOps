# Copia este archivo a .env SOLO para desarrollo local. Nunca subas .env al repositorio.
# En Docker se usan *_FILE con Docker secrets; en AWS los valores vienen de SSM Parameter Store.
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_USER=securenotes
DB_NAME=securenotes
DB_PASSWORD=cambia-esto
# Genera con: openssl rand -base64 48
JWT_SECRET=
ADMIN_PASSWORD=
COOKIE_SECURE=false
SEED_DEMO=true
